{
    "name": "@ostro/config",
    "version": "2.0.0-alpha.1",
    "description": "Config module for OstroJS",
    "main": "build/repository.js",
    "types": "build/repository.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/repository.d.ts",
            "default": "./build/repository.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/support": "^2.0.0-alpha.1",
        "lodash.get": "^4.4.2",
        "lodash.set": "^4.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "config"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/config.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/config/issues"
    },
    "homepage": "https://github.com/ostrojs/config#readme",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.8.0"
    }
}
