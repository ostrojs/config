{
    "name": "@ostro/config",
    "version": "2.0.0-alpha.5",
    "description": "Config module for OstroJS",
    "main": "repository.js",
    "types": "types/repository.d.ts",
    "exports": {
        ".": {
            "types": "./types/repository.d.ts",
            "default": "./repository.js"
        },
        "./*": {
            "types": "./types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/support": "^2.0.0-alpha.7",
        "lodash.get": "^4.4.2",
        "lodash.set": "^4.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "config"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/config.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/config/issues"
    },
    "homepage": "https://github.com/ostrojs/config#readme",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "@ostro/builder": "^2.0.0-alpha.4"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
